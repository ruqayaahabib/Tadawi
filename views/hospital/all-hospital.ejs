<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Hospitals</title>
</head>
<body>
    <h1>Hospitals</h1>
    <% for(let hospital of hospitals) {%>
        <h2><%= hospital.name  %></h2>
        <p>Location: <%= hospital.location %></p>
        <a href="/hospitals/<%= hospital._id %>">
            View Details
        </a>

        <img src="<%= hospital.imageUrl%>" alt="">

        <% } %>
</body>
</html>