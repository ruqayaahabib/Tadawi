<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hospital Details</title>


    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/hospital-details.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/style.css">


     <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>

     <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
    crossorigin=""></script>

    

</head>
<body>
    <%- include('../partials/navbar') %>
    <div class="hospital-page">
        <div class="hospital-header">
            <h1><%= hospital.name %></h1>
            <img src="<%= hospital.imageUrl %>" alt="<%= hospital.name %>">
                
        </div>
        <div class="hospital-content">
            <div class="hospital-information">
                <h2>Hospital Information</h2>
                <div class="information-item">
                    <i class="bi bi-geo-alt"></i>
                    <div>
                        <span>Location</span>
                        <p><%= hospital.location %></p>
                    </div>
                </div>
                <div class="information-item">
                    <i class="bi bi-telephone"></i>
                    <div>
                        <span>Phone Number</span>
                        <p><%= hospital.phone %></p>
                    </div>
                </div>
                <div class="information-item">
                    <i class="bi bi-card-text"></i>
                    <div>
                        <span>Description</span>
                        <p><%= hospital.description %></p>
                    </div>
                </div>
            </div>
            <div class="hospital-location">
                <h2>Location</h2>
                <div id="map"> </div>
            </div>
        </div>

            <div class="departments-section">
                <div class="departments-header">
                    <h2>Departments at this Hospital</h2>
                    <p>Explore the departments available at <%= hospital.name %>.</p>
                </div>
                <div class="departments-list">
                    <% for(let department of departments){%>
                        <div class="department-card">
                            <h3><%= department.name  %></h3>
                            <p><%= department.description %></p>
                            <a href="/departments/<%= department._id %>" class="department-button">
                                Explore Doctors
                            </a>
                        </div>
                                               
                        
                    <% } %>

                </div>
            </div>
        </div>

    <script>
        // // Create the map and center it on the hospital's saved location
        var map = L.map('map').setView([<%= hospital.latitude %>, <%= hospital.longitude %>], 17);

        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Add a marker at the hospital's location
        var marker = L.marker([<%= hospital.latitude %>, <%= hospital.longitude %>]).addTo(map);

    marker.bindPopup("<%= hospital.name%>") //pop up when marker clicked


    </script>


</body>
</html>