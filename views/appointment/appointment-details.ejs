<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Appointment Details</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Appointment Details</h1>
    <p>Date: <%= appointment.date%></p>
    <p>Time: <%= appointment.time  %></p>
    <p>Reason: <%= appointment.reason %></p>
    <p>Status: <%= appointment.status %></p>

    <a href="/appointments/<%= appointment._id %>/edit">Edit Appointment</a>
    <form action="/appointments/<%= appointment._id %>?_method=DELETE" method="POST">
    <button onclick="confirmDelete(event, 'Do you want to cancel this appointment?')">Cancel Appointment</button> </form>
</body>
</html>