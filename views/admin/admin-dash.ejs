<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="dashboard-content">
        <div class="dashboard-heading">
            <h1>Admin Dashboard</h1>
            <p>Manage hospitals, departments, doctors and appointments.</p>
        </div>
        <div class="dashboard-cards">
            <div class="dashboard-card">
                <div class="card-icon">
                    <i class="bi bi-hospital"></i>
                </div>

            <div class="card-info">
                <p>Total Hospitals</p>
                <h2><%= totalHospitals %></h2>
            </div>
        </div>


        <div class="dashboard-card">
            <div class="card-icon">
            <i class="bi bi-grid"></i>
            </div>

            <div class="card-info">
                <p>Total Departments</p>
                <h2><%= totalDepartments %></h2>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon">
                <i class="bi bi-person-badge"></i>
            </div>

            <div class="card-info">
                <p>Total Doctors</p>
                <h2><%= totalDoctors %></h2>
            </div>
        </div>

        <div class="dashboard-card">
            <div class="card-icon">
                <i class="bi bi-calendar-check"></i>
            </div>
            <div class="card-info">
                <p>Total Appointments</p>
                <h2><%= totalAppointments %></h2>
            </div>
        </div>
        </div>

        <div class="chart-card">

            <div class="chart-header">
                <!-- <h2>Top 5 Hospitals by Patient Appointments</h2> -->
                 <h2>Total Users by Role</h2>
            </div>

            <div class="chart-container">
                <canvas id="userChart"></canvas>
            </div>
        </div>
    </div>
    
    <script>
        const ctx = document.querySelector('#userChart')

        new Chart(ctx, {
            type: 'pie',

            data: {
                labels: ['Patients', 'Doctors', 'Admins'],

                datasets: [{
                    label: 'Users',
                    data: [
                        <%= totalPatients %>,
                        <%= totalDoctors %>,
                        <%= totalAdmins %>
                    ],

                    backgroundColor: [
                        '#5BBFB5',
                        '#4E8FBF',
                        '#F2B56B'
                    ]
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        })
    </script>
</body>
</html>