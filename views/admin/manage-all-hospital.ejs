<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage All Hospitals</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>


</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Manage Hospitals</h1>

    <a href="/admin/hospitals/new">Add New Hospital</a>
    <% for (let oneHospital of hospitals) {%>
        <%= oneHospital.imageUrl%>
        <img src="<%= oneHospital.imageUrl%>" alt="">
        <h2><%= oneHospital.name  %></h2>
        <p>Phone Number: <%= oneHospital.phone %></p>
        <p>Location: <%= oneHospital.location %></p>

        <a href="/admin/hospitals/<%= oneHospital._id %>/edit">Edit</a>
        <form action="/admin/hospitals/<%= oneHospital._id %>?_method=DELETE" method="POST">
        <button onclick="confirmDelete(event, 'Do you want to delete this hospital?')">Delete</button> </form>
        <% } %>

    <% if(message) {%>
        <script>
            Toastify({
            text: "<%= message %>",
            duration: 3000,
            close: true,
            style: {
                background: "#3B82F6",
                color: "white"
            }
            }).showToast();
        </script>
    <% } %>
</body>

</html>