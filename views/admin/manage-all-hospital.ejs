<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage All Hospitals</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin-manage.css">

</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="dashboard-content">
        <div class="manage-header">
            <div>
                <h1>Manage Hospitals</h1> 
                <p>View, add, edit or delete hospitals.</p>
            </div>
                <a href="/admin/hospitals/new" class="add-button">
                    <i class="bi bi-plus-lg"></i>
                    Add New Hospital</a> 
        </div>
        <div class="manage-table">
             <table>
                <thead>
                    <tr>
                        <th>Hospital</th>
                        <th>Location</th>
                        <th>Phone Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                
                <tbody>
                    <% for (let oneHospital of hospitals) {%>
                        <tr>
                            <td><%= oneHospital.name %></td>

                            <td><%= oneHospital.location %></td>
                            <td><%= oneHospital.phone %></td>

                        <td>
                            <div class="manage-actions">
                            <a href="/admin/hospitals/<%= oneHospital._id %>/edit" class="edit-button">
                                <i class="bi bi-pencil"></i>
                                Edit</a>
                        <form action="/admin/hospitals/<%= oneHospital._id %>?_method=DELETE" method="POST">
                        <button class="delete-button" onclick="confirmDelete(event, 'Do you want to delete this hospital?')">
                            <i class="bi bi-trash"></i>
                            Delete
                        </button> 
                    </form>
                    </div>                     
                    </td>
                    </tr>
        <% } %>
        </tbody>
    </table>
        </div>
    </div>


    <% if(message) {%>
        <script>
            Toastify({
            text: "<%= message %>",
            duration: 3000,
            close: true,
            style: {
                background: "#3B82F6",
                color: "white"
            }
            }).showToast();
        </script>
    <% } %>


</body>

</html>