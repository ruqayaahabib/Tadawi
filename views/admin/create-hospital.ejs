<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Hospital</title>
</head>
<body>
    <h1>Add Hospital</h1>
    <form action="/admin/hospitals" method="post">
