<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Doctor</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Add New Doctor</h1>
        <form action="/admin/doctors" method="post" enctype="multipart/form-data">
        <label for="username">Name:</label>
        <input id="username" name="username" type="text">

        <label for="email">Email: </label>
        <input type="email" name="email" id="email">

        <label for="password">Password:</label>
        <input id="password" name="password" type="password">



        <label for="department">Department:</label>
        <select name="department" id="department">
            <% for(let oneDepartment of departments){ %>
                <option value="<%= oneDepartment._id  %>">
                    <%= oneDepartment.name  %>
                </option>
                <% } %>
        </select>



        <label for="hospital">Hospital:</label>
        <select name="hospital" id="hospital">
            <% for(let oneHospital of hospitals){ %>
                <option value="<%= oneHospital._id  %>">
                    <%= oneHospital.name  %>
                </option>
                <% } %>
        </select>

        <label for="imageUrl">Photo:</label>
        <input id="imageUrl" name="imageUrl" type="file">

        <button>Add</button> 
    
    </form>

</body>
</html>