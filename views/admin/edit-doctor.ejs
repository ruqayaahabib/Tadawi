<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Edit Doctor</h1>
    <form action="/admin/doctors/<%=doctor._id%>?_method=PUT" method="post" enctype="multipart/form-data">
        <label for="username">Name:</label>
        <input value="<%= doctor.username  %>" id="username" name="username" type="text">

        <label for="password">Password:</label>
        <input id="password" name="password" type="password">


        <label for="department">Department:</label>
        <select name="department" id="department">
            <% for(let oneDepartment of departments){ %>
                <option value="<%= oneDepartment._id  %>">
                    <%= oneDepartment.name  %>
                </option>
                <% } %>
        </select>


        <label for="hospital">Hospital:</label>
        <select name="hospital" id="hospital">
            <% for(let oneHospital of hospitals){ %>
                <option value="<%= oneHospital._id  %>">
                    <%= oneHospital.name  %>
                </option>
                <% } %>
        </select>

        <label for="imageUrl">Photo:</label>
        <input id="imageUrl" name="imageUrl" type="file">

        <p>Original Doctor Picture</p>
        <img src="<%= doctor.imageUrl  %>" alt="">
        <button>Update</button> 
    
    </form>
</body>
</html>