<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Doctor</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/hospital-form.css">
    <link rel="stylesheet" href="/css/style.css">
    <script defer src="/js/create-doctor.js"></script>
</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="dashboard-content">
        <div class="form-header">
            <h1>Edit Doctor</h1>
            <p>Update doctor information.</p>
        </div>

        <form class="hospital-form" action="/admin/doctors/<%=doctor._id%>?_method=PUT" method="post" enctype="multipart/form-data">
            <div class="form-row">
                <div class="form-group">
                    <label for="username">Name:</label>
                    <input value="<%= doctor.username  %>" id="username" name="username" type="text">
                </div>
                <div class="form-group">
                    <label for="email">Email: </label>
                    <input value="<%= doctor.email %>" type="email" name="email" id="email">
                </div>
            </div>

            <div class="form-group">
                <label for="bio">Bio:</label>
                <input value="<%= doctor.bio %>" type="text" name="bio" id="bio">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="hospital">Hospital:</label>
                    <select class="form-select" name="hospital" id="hospital">
                        <% for(let oneHospital of hospitals){ %>
                        <option value="<%= oneHospital._id %>" <%= doctor.hospital.toString() === oneHospital._id.toString() ? "selected" : "" %>>
                            <%= oneHospital.name  %>
                        </option>
                        <% } %>
                    </select>
                </div>
            

            <div class="form-group">
                <label for="department">Department:</label>
                <select name="department" id="department">
                    <% for(let oneDepartment of departments){ %>
                        <option  value="<%= oneDepartment._id %>" <%= doctor.department.toString() === oneDepartment._id.toString() ? "selected" : "" %>>
                        <%= oneDepartment.name  %> - <%= oneDepartment.hospital.name  %>
                        </option>
                     <% } %>
                </select>
            </div>
        </div>

            <div class="form-group">
                <label for="imageUrl">Doctor Picture:</label>
                <img src="<%= doctor.imageUrl  %>" class="current-photo" alt="">
                <input id="imageUrl" name="imageUrl" type="file">
            </div>


        <button class="submit-button">Update</button> 
    
    </form>
</div>
</body>
</html>