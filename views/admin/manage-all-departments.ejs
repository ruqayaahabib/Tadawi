<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Department</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin-manage.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="dashboard-content">
        <div class="manage-header">
            <div>
                <h1>Manage Departments</h1>
                <p>View, add, edit or delete departments.</p>
            </div>

            <a href="/admin/departments/new" class="add-button">
                <i class="bi bi-plus-lg"></i>
                Add New Department</a>
        </div>

        <div class="manage-table">
            <table>
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Hospital</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>       
                    <% for (let oneDepartment of departments) {%>
                        <tr>
                            <td><%= oneDepartment.name %></td>
                            <td><%= oneDepartment.hospital.name %></td>
                            <td>
                                <div class="manage-actions">
                                    <a href="/admin/departments/<%= oneDepartment._id %>/edit" class="edit-button">
                                        <i class="bi bi-pencil"></i>
                                        Edit</a>
                                        <form action="/admin/departments/<%= oneDepartment._id %>?_method=DELETE" method="POST">
                                        <button class="delete-button" onclick="confirmDelete(event, 'Do you want to delete this department?')">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
        <% if(message) {%>
        <script>
            Toastify({
            text: "<%= message %>",
            duration: 3000,
            close: true,
            style: {
                background: "#3B82F6"
            }
            }).showToast();
        </script>
    <% } %>


</body>
</html>