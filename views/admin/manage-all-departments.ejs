<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Department</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Manage Department</h1>

    <a href="/admin/departments/new">Add New Department</a>
    <% for (let oneDepartment of departments) {%>
        <h2><%= oneDepartment.name  %></h2>
        <p>Description: <%= oneDepartment.description %></p>
        <p>Hospital: <%= oneDepartment.hospital.name %></p>



        <a href="/admin/departments/<%= oneDepartment._id %>/edit">Edit</a>
        <form action="/admin/departments/<%= oneDepartment._id %>?_method=DELETE" method="POST">
        <button onclick="confirmDelete(event, 'Do you want to delete this department?')">Delete</button> </form>
        <% } %>



        <% if(message) {%>
        <script>
            Toastify({
            text: "<%= message %>",
            duration: 3000,
            close: true,
            style: {
                background: "#3B82F6"
            }
            }).showToast();
        </script>
    <% } %>


</body>
</html>