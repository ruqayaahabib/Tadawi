<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Doctors</title>
</head>
<body>
    <h1>Manage Doctors</h1>
    <a href="/admin/doctors/new">Add New Doctor</a>
        <% for (let oneDoctor of doctors) {%>
        <%= oneDoctor.imageUrl%>
        <img src="/<%= oneDoctor.imageUrl%>" alt="">

        <h2><%= oneDoctor.username  %></h2>

        <p>Department: <%= oneDoctor.department.name %></p>
        <p>Hospital: <%= oneDoctor.hospital.name  %></p>

        <a href="/admin/doctors/<%= oneDoctor._id %>/edit">Edit</a>
        <form action="/admin/doctors/<%= oneDoctor._id %>?_method=DELETE" method="POST">
        <button>Delete</button> </form>
        <% } %>
</body>
</html>