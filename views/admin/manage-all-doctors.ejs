<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Doctors</title>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/delete-confirmation.js"></script>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Manage Doctors</h1>
    <a href="/admin/doctors/new">Add New Doctor</a>
        <% for (let oneDoctor of doctors) {%>
        <%= oneDoctor.imageUrl%>
        <img src="<%= oneDoctor.imageUrl%>" alt="">

        <h2><%= oneDoctor.username  %></h2>

        <p>Department: <%= oneDoctor.department.name %></p>
        <p>Hospital: <%= oneDoctor.hospital.name  %></p>

        <a href="/admin/doctors/<%= oneDoctor._id %>/edit">Edit</a>
        <form action="/admin/doctors/<%= oneDoctor._id %>?_method=DELETE" method="POST">
        <button onclick="confirmDelete(event, 'Do you want to delete this doctor?')">Delete</button> </form>
        <% } %>

    <% if(message) {%>
        <script>
            Toastify({
                text: "<%= message %>",
                duration: 3000,
                close: true,
                style: {
                    background: "#3B82F6"
                }
            }).showToast();
        </script>
    <% } %>

</body>
</html>