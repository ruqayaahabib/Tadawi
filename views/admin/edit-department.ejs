<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Department</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/hospital-form.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/sidebar') %>
    <div class="dashboard-content">
        <div class="form-header">
            <h1>Edit Department</h1>
            <p>Update the department and its information.</p>
        </div>

        <form class="hospital-form" action="/admin/departments/<%=department._id%>?_method=PUT" method="post">
            <div class="form-group">
                <label for="name">Name:</label>
                <input value="<%= department.name  %>" id="name" name="name" type="text">
            </div>

            <div class="form-group">
                <label for="description">Description:</label>
                <input value="<%= department.description  %>" id="description" name="description" type="text">
            </div>
        
            <div class="form-group">
                <label for="hospital">Hospital:</label>
                <select class="form-select" id="hospital" name="hospital">
                    <%for (let oneHospital of hospitals){%>
                        <option value="<%= oneHospital._id %>" <%= department.hospital.toString() === oneHospital._id.toString() ? "selected" : "" %>>
                            <%= oneHospital.name%>

                         </option>
                    <%}%> 
                </select>
            </div>

        <button class="submit-button">Update</button>
     </form>
</div>
</body>
</html>