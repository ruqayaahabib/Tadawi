<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doctor Appointments</title>

    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>My Appointments</h1>
    <% for(let oneAppointment of appointments){%> 
        <h2>Patient: <%= oneAppointment.patient.username %></h2>
        <p>Date: <%= oneAppointment.date %></p>
        <p>Time: <%= oneAppointment.time  %></p>
        <p>Status: <%= oneAppointment.status  %></p>

        <a href="/doctor/appointments/<%= oneAppointment._id %>">View Details</a>
    <% } %>

    <% if(message) {%>
        <script>
            Toastify({
                text: "<%= message %>",
                duration: 3000,
                close: true,
                style: {
                    background: "#8B5CF6"
                }
            }).showToast();
            </script>
    <% } %>
</body>
</html>