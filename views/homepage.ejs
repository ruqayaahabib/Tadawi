<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TADAWI</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>
    <%- include('./partials/navbar') %>

    <div class="home-intro">
        <div class="background-image"></div>
        <div class="intro-content">
            <h1 class="intro-label">Your Health</h1>
            <h1 class="intro-title">Our Priority</h1>
            <a href="/hospitals" class="browse-button">Explore Hospitals</a>
        </div>
    </div>

    <section class="why-section">

    <div class="why-heading">
        <h2>Why Tadawi?</h2>
        <p>Simple healthcare, all in one place.</p>
    </div>

    <div class="why-cards">

        <div class="why-card">
            <i class="bi bi-hospital"></i>
            <h3>Find Hospitals</h3>
            <p>Explore hospitals and departments in one place.</p>
        </div>

        <div class="why-card">
            <i class="bi bi-calendar-check"></i>
            <h3>Easy Booking</h3>
            <p>Book and manage your appointments easily.</p>
        </div>

        <div class="why-card">
            <i class="bi bi-person-badge"></i>
            <h3>Find Doctors</h3>
            <p>Find doctors by hospital and department.</p>
        </div>

    </div>

    </section>



    <section class="hospitals-section">

    <div class="hospitals-heading">
        <h2>Our Hospitals</h2>
        <p>Explore healthcare providers available through Tadawi.</p>
    </div>

    <!-- First Row -->
    <div class="hospital-row" data-direction="left">
        <div class="hospital-track">

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital1.png" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital2.jpeg" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital3.jpeg" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital4.jpeg" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital5.jpeg" alt="Hospital">
            </div>

        </div>
    </div>


    <!-- Second Row -->
    <div class="hospital-row" data-direction="right">
        <div class="hospital-track">

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital6.png" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital7.png" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital8.jpeg" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital9.jpg" alt="Hospital">
            </div>

            <div class="hospital-logo">
                <img src="/images/hospitals/hospital10.jpeg" alt="Hospital">
            </div>

        </div>
    </div>

</section>

    <footer class="footer">

    <div class="footer-content">

        <div class="footer-brand">
            <h2>TADAWI</h2>
            <p>Your health, our priority.</p>
        </div>

    </div>

    <div class="footer-bottom">
        <p>© 2026 TADAWI. All rights reserved.</p>
    </div>

    </footer>
</body>
</html>